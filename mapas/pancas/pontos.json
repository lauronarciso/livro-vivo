e\nquase vertical.\n\nO acesso se faz pelo lado da cidade, deixando o\ncarro ao final de uma estrada de chão. A caminhada para\nchegar na base da via é um crux, pois é difícil de achar a\nbase da via. Não é possível ver as primeiras proteções do\nchão. Clique no Plus Code para ver a localização da base\nda via.","f":[],"det":""},{"c":2,"n":28,"nome":"Pedra da Tartaruga","lat":-19.222513,"lon":-40.821118,"d":"","f":[],"det":""},{"c":2,"n":29,"nome":"Pedra Garrafão","lat":-19.220328,"lon":-40.799811,"d":"","f":[],"det":""},{"c":2,"n":30,"nome":"Pedra da Boca","lat":-19.223377,"lon":-40.785981,"d":"","f":[],"det":""},{"c":2,"n":31,"nome":"Trono do Jacaré","lat":-19.230223,"lon":-40.782888,"d":"","f":[],"det":""},{"c":2,"n":32,"nome":"Mega Tirolesa dos Pontões","lat":-19.238123,"lon":-40.836177,"d":"","f":[],"det":""},{"c":2,"n":33,"nome":"Pedra do Gorila","lat":-19.252472,"lon":-40.828,"d":"","f":[],"det":""},{"c":2,"n":34,"nome":"Pedra da Agulhina","lat":-19.253944,"lon":-40.817139,"d":"","f":[],"det":""},{"c":2,"n":35,"nome":"Pedra da Gaveta","lat":-19.241938,"lon":-40.816122,"d":"","f":[],"det":""},{"c":2,"n":36,"nome":"Pedra Agulha","lat":-19.25301,"lon":-40.812766,"d":"","f":[],"det":""},{"c":2,"n":37,"nome":"Pedra da Cara","lat":-19.243084,"lon":-40.800348,"d":"","f":[],"det":""},{"c":2,"n":38,"nome":"Pedra do Camelo","lat":-19.233165,"lon":-40.798611,"d":"","f":[],"det":""},{"c":2,"n":39,"nome":"Pedra do Tubarão","lat":-19.2425,"lon":-40.798028,"d":"","f":[],"det":""},{"c":2,"n":40,"nome":"Pedra Martinelli","lat":-19.245559,"lon":-40.794935,"d":"","f":[],"det":""},{"c":2,"n":41,"nome":"Parede do Raash/Barbatana","lat":-19.243809,"lon":-40.787062,"d":"","f":[],"det":""},{"c":2,"n":42,"nome":"Pedra do Córrego","lat":-19.26025,"lon":-40.753444,"d":"","f":[],"det":""},{"c":2,"n":43,"nome":"Pedra Esticada","lat":-19.264716,"lon":-40.747892,"d":"","f":[],"det":""},{"c":2,"n":44,"nome":"Pedra da Jararaca","lat":-19.287657,"lon":-40.744682,"d":"","f":[],"det":""},{"c":2